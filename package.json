{
  "name": "maotuan",
  "productName": "毛团",
  "version": "0.6.0",
  "description": "一团住在桌面上的小毛团：陪你、跟你聊天、读东西给你听。",
  "main": "main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64",
    "dist:all": "electron-builder --mac --win --x64"
  },
  "build": {
    "appId": "com.chengxiyan.maotuan",
    "productName": "毛团",
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null,
      "icon": "assets/icon.png",
      "artifactName": "maotuan-${version}-${os}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "毛团要听你说话（按住麦克风的时候）",
        "NSSpeechRecognitionUsageDescription": "毛团要听你说话"
      }
    },
    "files": [
      "main/**",
      "renderer/**",
      "mcp/**",
      "assets/**",
      "package.json"
    ],
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "maotuan-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "毛团",
      "perMachine": false,
      "artifactName": "maotuan-${version}-win-x64-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "portable": {
      "artifactName": "maotuan-${version}-win-x64-portable.${ext}"
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "^0.153.4",
    "opencc-js": "^1.4.2",
    "pdf-parse": "^2.4.5",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^7.4.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "author": "chengxiyan"
}
